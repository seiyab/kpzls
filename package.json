{
	"name": "kpzls",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=24.3.0"
	},
	"scripts": {
		"build": "vite build && vite build --config vite.server.config.ts",
		"dev": "pnpm build && wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run"
	},
	"dependencies": {
		"remix": "3.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"oxlint": "^1.89.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
